# HostingBeyond — STAGING environment template (names only; copy to server as .env)
# Never use production secrets. Never point at production DATABASE_URL.

NEXT_PUBLIC_APP_URL="https://staging.example.test"
NEXT_PUBLIC_APP_NAME="HostingBeyond (Staging)"
NEXT_PUBLIC_SITE_URL="https://staging.example.test"

# Isolated staging database (dedicated role + database)
DATABASE_URL="postgresql://hostingbeyond_staging_user:CHANGE_ME@127.0.0.1:5432/hostingbeyond_staging_db?schema=public"

ORBIT_UPLOAD_DIR="/data/hostingbeyond-staging/uploads"

ORBIT_ENROLLMENT_SECRET="CHANGE_ME_STAGING_ONLY"
ORBIT_SESSION_SECRET="CHANGE_ME_STAGING_ONLY"
ORBIT_RP_ID="staging.example.test"
ORBIT_ORIGIN="https://staging.example.test"

# Customer OAuth — staging redirect URIs in each provider console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Domain Name API — OTE / test only (no live registrations)
DOMAIN_API_RESELLER_ID=""
DOMAIN_API_TEST_KEY=""
DOMAIN_API_LIVE_KEY=""
DOMAIN_API_ENV="test"
DOMAIN_AVAILABILITY_ENV="test"

# Stripe — test mode only
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional dev helper — must NOT be set on production
# BEYOND_AI_DEV_ACTIVATE_PAID="true"
