# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HostingBeyond"
NEXT_PUBLIC_SITE_URL="https://hosting.theglobalorbit.com"

# Database — HostingBeyond ONLY (never reuse other project DBs/users)
DATABASE_URL="postgresql://hostingbeyond_user:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/hostingbeyond_db?schema=public"

# Runtime uploads (production uses a path outside the Git tree)
ORBIT_UPLOAD_DIR="/data/hostingbeyond/uploads"

# Orbit Super Admin (server-only — never commit real values)
# Enrollment secret is used ONLY for first-time passkey registration.
# It is NOT a login password and must never be hardcoded in frontend code.
ORBIT_ENROLLMENT_SECRET="YOUR_ENROLLMENT_SECRET"
ORBIT_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SECRET"
ORBIT_RP_ID="localhost"
ORBIT_ORIGIN="http://localhost:3000"

# Customer social login (optional — email signup/login works without these)
# Redirect URIs:
#   https://hosting.theglobalorbit.com/api/auth/oauth/google/callback
#   https://hosting.theglobalorbit.com/api/auth/oauth/github/callback
#   https://hosting.theglobalorbit.com/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Domain availability (server-only — required in production for live search)
# Domain Name API (preferred — OTE when DOMAIN_API_ENV=test)
DOMAIN_API_RESELLER_ID=""
DOMAIN_API_TEST_KEY=""
DOMAIN_API_LIVE_KEY=""
DOMAIN_API_ENV="test"
# Customer-facing search uses LIVE registry by default in production
DOMAIN_AVAILABILITY_ENV="live"
# Short-lived search cache (ms, 5–60s)
DOMAIN_SEARCH_CACHE_TTL_MS="20000"
# Optional premium markup over supplier registry cost (percent)
DOMAIN_PREMIUM_MARKUP_PERCENT="20"

# Legacy HTTP proxy (optional fallback if DNA is not configured)
# POST JSON: { query?, bulk?, tlds?, names? } → { results: DomainResult[] }
DOMAIN_LOOKUP_URL=""
DOMAIN_LOOKUP_TOKEN=""

# NameSilo — separate from Domain Name API. Search uses the key; lifecycle stays off
# unless both flags are the exact string true (never 1). Do not enable in example.
# DOMAIN_PUBLIC_SEARCH_AVAILABILITY_PROVIDER="namesilo"
# NAMESILO_API_KEY=""
# NAMESILO_API_URL="https://www.namesilo.com/api"
# NAMESILO_BATCH_URL="https://www.namesilo.com/apibatch"
# NAMESILO_LIFECYCLE_ENABLED="false"
# NAMESILO_ALLOW_BILLABLE="false"

# Stripe — wallet top-up (server-only; webhook must be configured for credits)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Dashboard → Developers → Webhooks → endpoint: https://YOUR_HOST/api/webhooks/stripe
# Listen for: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed

# Google Cloud Translation v3 (server-only). Independent of Google OAuth.
# Point at a service-account JSON *path* — never put the JSON in this file.
# See docs/GOOGLE-CLOUD-TRANSLATION.md. Keep disabled until the operator is ready.
# GOOGLE_TRANSLATE_ENABLED="false"
# GOOGLE_CLOUD_PROJECT="hostingbeyond-513017"
# GOOGLE_APPLICATION_CREDENTIALS="/secure/hostingbeyond/google-translate-sa.json"
# GOOGLE_TRANSLATE_CREDENTIALS_PATH=""

# Transactional mail (fail closed unless EMAIL_DELIVERY_ENABLED=1)
# EMAIL_DELIVERY_ENABLED="0"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
# TRANSACTIONAL_EMAIL_API_KEY=""

# Hosting provisioner (independent of registrars; enable flag must be 1)
# HOSTING_PROVISIONER_ENABLED="0"
# HOSTING_PROVISIONER_BASE_URL=""
# HOSTING_PROVISIONER_API_TOKEN=""
# HOSTING_PROVISIONER_WEBHOOK_SECRET=""
