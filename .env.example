# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HostingBeyond"
NEXT_PUBLIC_SITE_URL="https://hosting.theglobalorbit.com"

# Database — HostingBeyond ONLY (never reuse other project DBs/users)
DATABASE_URL="postgresql://hostingbeyond_user:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/hostingbeyond_db?schema=public"

# Runtime uploads (production uses a path outside the Git tree)
ORBIT_UPLOAD_DIR="/data/hostingbeyond/uploads"

# Orbit Super Admin (server-only — never commit real values)
# Enrollment secret is used ONLY for first-time passkey registration.
# It is NOT a login password and must never be hardcoded in frontend code.
ORBIT_ENROLLMENT_SECRET="YOUR_ENROLLMENT_SECRET"
ORBIT_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SECRET"
ORBIT_RP_ID="localhost"
ORBIT_ORIGIN="http://localhost:3000"
