# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
.playwright-browsers/
.qa-phase1/
.qa-phase2-responsive/

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env
.env
.env.*
!.env.example
.env*.local
.env.integration.local
.env.production
.env.development

# Session/cookie dumps — never commit
headers.txt

# Production upload tree (outside the Git checkout)
/data/hostingbeyond/

# Uploads (runtime media — keep folder, ignore files)
/public/uploads/*
!/public/uploads/.gitkeep
/data/uploads/*
!/data/uploads/.gitkeep

# Portable Orbit CMS dumps — commit these for clone/migrate
!/data/db/
!/data/db/**

# Vercel / Netlify
.vercel
.netlify

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma — commit migrations; do not ignore lock file

# Local backup output (ops/backup scripts)
/data/backups/

# Database backups — NEVER commit PostgreSQL dumps
*.dump
*.sql
*.sql.gz
*.backup
*.bak
!/prisma/migrations/
!/prisma/migrations/**

# Local tooling binaries — never commit executables
.local-stripe-cli

# One-off audit / pricing artifacts (keep reports in docs/ instead)
NAMESILO_*.md
NAMESILO_*.csv
NAMESILO_*.json
DOMAIN_PLATFORM_IMPLEMENTATION_REPORT.md
audit-*.json
experiment-*.json

# Preserved agent scratch output
.cursor-preserve-untracked/
