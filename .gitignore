# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env
.env
.env.*
!.env.example
.env*.local
.env.production
.env.development

# Session/cookie dumps — never commit
headers.txt

# Production upload tree (outside the Git checkout)
/data/hostingbeyond/

# Uploads (runtime media — keep folder, ignore files)
/public/uploads/*
!/public/uploads/.gitkeep
/data/uploads/*
!/data/uploads/.gitkeep

# Portable Orbit CMS dumps — commit these for clone/migrate
!/data/db/
!/data/db/**

# Vercel / Netlify
.vercel
.netlify

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma — commit migrations; do not ignore lock file

# Database backups — NEVER commit PostgreSQL dumps
*.dump
*.sql
*.sql.gz
*.backup
*.bak
