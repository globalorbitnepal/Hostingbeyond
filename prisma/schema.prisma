// HostingBeyond — Prisma schema (PostgreSQL)
// Orbit Super Admin CMS + WebAuthn credentials

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ENROLL
  CONTENT_UPDATE
  MEDIA_UPLOAD
  MEDIA_REPLACE
  MEDIA_DELETE
  SETTINGS_UPDATE
  NAV_UPDATE
  SEO_UPDATE
  BLOG_UPDATE
  DOMAIN_PRICING_UPDATE
  DOMAIN_ORDER_UPDATE
  DOMAIN_PROVIDER_SYNC
  MIGRATION_REQUEST_UPDATE
  WALLET_TRANSACTION
}

enum DomainOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  REGISTERING
  REGISTERED
  RECONCILIATION_REQUIRED
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum DomainServiceStatus {
  ACTIVE
  PENDING_REGISTRATION
  EXPIRED
  SUSPENDED
  TRANSFER_OUT
  FAILED
}

enum DomainTransferStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationRequestStatus {
  NEW
  REVIEWING
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  COMPLETED
  FAILED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  RESERVE
  RELEASE
  REFUND
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletPaymentStatus {
  PENDING
  CHECKOUT_CREATED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum DomainProviderLogLevel {
  INFO
  WARN
  ERROR
}

model AdminUser {
  id           String              @id @default(cuid())
  displayName  String              @default("Super Admin")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  credentials  WebAuthnCredential[]
  sessions     AdminSession[]
  activityLogs ActivityLog[]
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([adminUserId])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  userAgent   String?
  ipAddress   String?

  @@index([adminUserId])
  @@index([expiresAt])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model SiteSettings {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model PageContent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  isPublished Boolean  @default(true)
  isVisible   Boolean  @default(true)
  seo         Json?
  sections    Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String   @default("")
  url          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([mimeType])
}

model ActivityLog {
  id          String         @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      ActivityAction
  resource    String?
  details     String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([action])
}

model CustomerUser {
  id           String                 @id @default(cuid())
  email        String                 @unique
  passwordHash String?
  name         String?
  image        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     CustomerSession[]
  accounts     CustomerOAuthAccount[]
  beyondAi     BeyondAiSubscription?
  beyondAiProjects BeyondAiProject[]
  hostingOrders HostingOrder[]
  wallet              CustomerWallet?
  walletTransactions  WalletTransaction[]
  walletPayments      WalletPayment[]
  domainCart          DomainCart?
  domainOrders        DomainOrder[]
  domainRegistrations DomainRegistration[]
  domainTransfers     DomainTransferRecord[]
  migrationRequests   MigrationRequest[]
}

enum HostingOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROVISIONING
  ACTIVE
  CANCELLED
  FAILED
  EXPIRED
}

model HostingOrder {
  id            String             @id @default(cuid())
  userId        String?
  user          CustomerUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        HostingOrderStatus @default(DRAFT)
  productSlug   String
  planKey       String
  billingCycle  String
  configuration Json               @default("{}")
  /// Immutable quote at order creation — do not recompute from live catalog for invoices.
  lineItemsSnapshot Json?
  currency      String             @default("USD")
  subtotal      Decimal            @db.Decimal(10, 2)
  discount      Decimal            @default(0) @db.Decimal(10, 2)
  tax           Decimal?           @db.Decimal(10, 2)
  total         Decimal            @db.Decimal(10, 2)
  paymentProvider   String?
  paymentReference  String?
  paymentStatus     String?
  paidAt            DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([productSlug, planKey])
}

enum HostingAddonBillingMode {
  MATCH_HOSTING
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum HostingAddonType {
  BUSINESS_EMAIL
  DOMAIN_PRIVACY
  BACKUP
  SUPPORT
  MIGRATION
  STORAGE
  IP
  SSL
  SECURITY
  OTHER
}

model HostingAddon {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             String
  description      String                  @default("")
  type             HostingAddonType        @default(OTHER)
  active           Boolean                 @default(true)
  displayOrder     Int                     @default(0)
  billingMode      HostingAddonBillingMode @default(MATCH_HOSTING)
  eligibility      Json                    @default("{}")
  /// e.g. cms:business-email — resolved server-side; never trusted from browser.
  pricingReference String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([active])
  @@index([displayOrder])
}

model BeyondAiSubscription {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  status             String       @default("active")
  monthlyCreditUsd   Float
  creditRemainingUsd Float
  onDemandEnabled    Boolean      @default(false)
  onDemandAccruedUsd Float        @default(0)
  billingInterval    String       @default("monthly")
  currentPeriodEnd   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([planId])
  @@index([status])
}

model BeyondAiProject {
  id          String       @id @default(cuid())
  userId      String
  user        CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      String       @default("draft")
  domain      String?
  publishedUrl String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model CustomerSession {
  id        String       @id @default(cuid())
  userId    String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

model CustomerOAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum HostingProductCategory {
  WEBSITE
  DEVELOPER
  VPS
  BUSINESS
}

enum HostingProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Catalog hosting products (public pages + checkout references).
model HostingProduct {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  name                  String
  category              HostingProductCategory
  status                HostingProductStatus   @default(ACTIVE)
  icon                  String?
  displayOrder          Int                    @default(0)
  featured              Boolean                @default(false)
  badge                 String?
  canonicalPath         String
  shortDescription      String                 @default("")
  heroTitle             String                 @default("")
  heroDescription       String                 @default("")
  heroImage             String?
  heroVideo             String?
  heroCtaLabel          String?
  heroCtaHref           String?
  secondaryCtaLabel     String?
  secondaryCtaHref      String?
  benefits              Json                   @default("[]")
  features              Json                   @default("[]")
  includedFeatures      Json                   @default("[]")
  specifications        Json                   @default("{}")
  faqs                  Json                   @default("[]")
  sectionFlags          Json                   @default("{}")
  seo                   Json?
  billingMonthlyEnabled Boolean                @default(true)
  billingYearlyEnabled  Boolean                @default(true)
  /// When true, eligible annual checkout may include a free domain for the first year.
  freeDomainAnnualEnabled Boolean              @default(false)
  /// Maps to legacy `PageContent.slug` for hero copy until fully migrated in admin.
  legacyCmsSlug         String?
  pageTemplate          String                 @default("standard")
  seoRegistrySlug       String?
  plans                 HostingProductPlan[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([category])
  @@index([status])
  @@index([displayOrder])
}

model HostingProductPlan {
  id            String         @id @default(cuid())
  productId     String
  product       HostingProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  planKey       String
  planName      String
  monthlyPrice  Decimal        @db.Decimal(10, 2)
  yearlyPrice   Decimal        @db.Decimal(10, 2)
  currency      String         @default("USD")
  setupFee      Decimal        @default(0) @db.Decimal(10, 2)
  tagline       String?
  storage       String?
  bandwidth     String?
  websites      String?
  domains       String?
  emailAccounts String?
  databases     String?
  ssl           String?
  backup        String?
  support       String?
  features      Json           @default("[]")
  popular       Boolean        @default(false)
  sortOrder     Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([productId, planKey])
  @@index([productId])
  @@index([active])
}

/// Per-TLD supplier + HostingBeyond retail pricing (Orbit-editable).
model DomainTldPrice {
  id                   String    @id @default(cuid())
  tld                  String    @unique
  supplierRegister     Decimal?  @db.Decimal(10, 4)
  supplierRenew        Decimal?  @db.Decimal(10, 4)
  supplierTransfer     Decimal?  @db.Decimal(10, 4)
  supplierRestore      Decimal?  @db.Decimal(10, 4)
  supplierCurrency     String    @default("USD")
  supplierSyncedAt     DateTime?
  supplierMaxRegisterYears Int?
  retailRegister       Decimal   @db.Decimal(10, 2)
  retailRenew          Decimal   @db.Decimal(10, 2)
  retailTransfer       Decimal   @db.Decimal(10, 2)
  retailRestore        Decimal?  @db.Decimal(10, 2)
  retailRegisterByYear Json?
  retailRenewByYear    Json?
  retailCurrency       String    @default("USD")
  minMarginPercent     Decimal   @default(0) @db.Decimal(5, 2)
  premiumMarkupPercent Decimal?  @db.Decimal(5, 2)
  promoRegister        Decimal?  @db.Decimal(10, 2)
  promoEndsAt          DateTime?
  enabled              Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enabled])
}

model DomainOrder {
  id                     String             @id @default(cuid())
  publicId               String             @unique
  userId                 String?
  user                   CustomerUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderType              String
  domain                 String
  tld                    String
  status                 DomainOrderStatus  @default(PENDING_PAYMENT)
  provider               String             @default("domain-name-api")
  providerOrderId        String?
  supplierCost           Decimal?           @db.Decimal(10, 4)
  retailPrice            Decimal            @db.Decimal(10, 2)
  discount               Decimal            @default(0) @db.Decimal(10, 2)
  tax                    Decimal?           @db.Decimal(10, 2)
  total                  Decimal            @db.Decimal(10, 2)
  currency               String             @default("USD")
  paymentProvider        String?
  paymentReference       String?
  walletTransactionId    String?
  idempotencyKey         String?            @unique
  errorCode              String?
  errorMessageInternal   String?
  errorMessageCustomer   String?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  registration           DomainRegistration?

  @@index([userId])
  @@index([status])
  @@index([domain])
  @@index([createdAt])
}

model DomainRegistration {
  id               String              @id @default(cuid())
  userId           String?
  user             CustomerUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  domain           String              @unique
  tld              String
  status           DomainServiceStatus @default(PENDING_REGISTRATION)
  providerDomainId String?
  orderId          String?             @unique
  order            DomainOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  registeredAt     DateTime?
  expiresAt        DateTime?
  autoRenew        Boolean             @default(true)
  lastRenewalAt    DateTime?
  nameservers      Json?
  transferLock     Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model DomainTransferRecord {
  id                   String               @id @default(cuid())
  publicId             String               @unique
  userId               String?
  user                 CustomerUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  domain               String
  tld                  String
  status               DomainTransferStatus @default(DRAFT)
  authCodeHint         String?
  currentRegistrar     String?
  providerTransferId   String?
  supplierCost         Decimal?             @db.Decimal(10, 4)
  retailPrice          Decimal              @db.Decimal(10, 2)
  total                Decimal              @db.Decimal(10, 2)
  currency             String               @default("USD")
  orderId              String?
  errorCode            String?
  errorMessageInternal String?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([domain])
}

model MigrationRequest {
  id                 String                 @id @default(cuid())
  publicId           String                 @unique
  userId             String?
  user               CustomerUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String?
  websiteUrl         String?
  currentProvider    String?
  domain             String?
  websiteType        String?
  emailAccountsCount Int?
  websiteSize        String?
  databaseRequired   Boolean                @default(false)
  preferredDate      DateTime?
  notes              String?
  status             MigrationRequestStatus @default(NEW)
  priority           Int                    @default(0)
  assignedStaff      String?
  adminNotes         String?
  customerNotes      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model CustomerWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  userId          String
  user            CustomerUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            WalletTransactionType
  status          WalletTransactionStatus @default(PENDING)
  amount          Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("USD")
  balanceAfter    Decimal?                @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?                 @unique
  note            String?
  createdAt       DateTime                @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model WalletPayment {
  id                        String              @id @default(cuid())
  publicId                  String              @unique
  userId                    String
  user                      CustomerUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                    Decimal             @db.Decimal(12, 2)
  currency                  String              @default("USD")
  status                    WalletPaymentStatus @default(PENDING)
  provider                  String              @default("stripe")
  providerCheckoutSessionId String?             @unique
  providerPaymentIntentId   String?             @unique
  walletTransactionId       String?             @unique
  idempotencyKey            String              @unique
  failureReason             String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  completedAt               DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model DomainCart {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      CustomerUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     DomainCartItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model DomainCartItem {
  id           String     @id @default(cuid())
  cartId       String
  cart         DomainCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  domain       String
  tld          String
  periodYears  Int        @default(1)
  status       String
  register     Decimal    @db.Decimal(10, 2)
  renew        Decimal    @db.Decimal(10, 2)
  currency     String     @default("USD")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([cartId, domain])
  @@index([cartId])
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogContentType {
  BLOG
  TIP
}

enum BlogGuideType {
  HOW_TO
  STEP_BY_STEP
  BEGINNER_GUIDE
  TROUBLESHOOTING
  BEST_PRACTICES
  EXPLAINER
  CHECKLIST
}

model BlogAuthor {
  id          String     @id @default(cuid())
  name        String
  displayName String?
  bio         String     @default("")
  avatarUrl   String?
  role        String?
  websiteUrl  String?
  twitterUrl  String?
  linkedinUrl String?
  adminUserId String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model BlogCategory {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String     @default("")
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noIndex        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  posts          BlogPost[]

  @@index([slug])
}

model BlogTag {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @default("")
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  posts          BlogPostTag[]

  @@index([slug])
}

model BlogPost {
  id                   String                 @id @default(cuid())
  title                String
  slug                 String                 @unique
  excerpt              String                 @default("")
  contentHtml          String                 @default("") @db.Text
  status               BlogPostStatus         @default(DRAFT)
  contentType          BlogContentType        @default(BLOG)
  guideType            BlogGuideType?
  featured             Boolean                @default(false)
  featuredImageUrl     String?
  featuredImageAlt     String?
  authorId             String?
  author               BlogAuthor?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             BlogCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  scheduledAt          DateTime?
  readingTimeMinutes   Int                    @default(0)
  readingTimeOverride  Int?
  canonicalUrl         String?
  noIndex              Boolean                @default(false)
  seoTitle             String?
  seoDescription       String?
  focusKeyword         String?
  seoKeywords          String[]               @default([])
  ogTitle              String?
  ogDescription        String?
  ogImageUrl           String?
  twitterTitle         String?
  twitterDescription   String?
  twitterImageUrl      String?
  schemaType           String                 @default("BlogPosting")
  allowComments        Boolean                @default(false)
  viewCount            Int                    @default(0)
  previewToken         String?                @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tags                 BlogPostTag[]
  slugRedirects        BlogPostSlugRedirect[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
  @@index([slug])
  @@index([contentType, status, publishedAt])
  @@index([contentType, viewCount])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPostSlugRedirect {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromSlug  String   @unique
  createdAt DateTime @default(now())

  @@index([postId])
}

model DomainProviderLog {
  id                   String                 @id @default(cuid())
  level                DomainProviderLogLevel @default(INFO)
  operation            String
  success              Boolean
  durationMs           Int?
  errorCode            String?
  errorMessageInternal String?
  metadata             Json?
  createdAt            DateTime               @default(now())

  @@index([createdAt])
  @@index([operation])
  @@index([success])
}

model DomainAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  resource    String?
  resourceId  String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([resource])
}
